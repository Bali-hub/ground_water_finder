import os
import zipfile
import shutil
from datetime import datetime
from pathlib import Path
import io

# ================== CONFIGURATION MATPLOTLIB POUR DOCKER ==================
import matplotlib

# Forcer le backend non-interactif pour Docker
matplotlib.use("Agg")
# ==========================================================================

import streamlit as st
import geopandas as gpd
import matplotlib.pyplot as plt
import contextily as ctx
from shapely.geometry import Point, Polygon
from shapely.ops import unary_union
import gpxpy
from lxml import etree
import matplotlib.patches as mpatches
import simplekml

# ================== STREAMLIT CONFIG ==================
st.title("🗺️ Carte de prospection – Affichage complet")

# ================== CHEMINS PORTABLES ==================
PROJECT_ROOT = Path(__file__).resolve().parent.parent
BASE_CLIENTS = PROJECT_ROOT / "data" / "Dossier_clients"

# ================== FONCTIONS ==================
def choisir_dossier_client():
    """Sélection automatique du dernier client"""
    if not BASE_CLIENTS.exists():
        st.error(f"❌ Le dossier {BASE_CLIENTS} n'existe pas.")
        st.stop()

    dossiers = [d for d in BASE_CLIENTS.iterdir() if d.is_dir()]
    if not dossiers:
        st.error(f"❌ Aucun dossier client trouvé dans {BASE_CLIENTS}")
        st.stop()

    nom_client = sorted(dossiers, reverse=True)[0].name
    dossier_client = BASE_CLIENTS / nom_client
    st.success(f"📁 Client détecté automatiquement : {nom_client}")
    return dossier_client, nom_client

def load_contour(file_path: Path):
    """Charge un polygone à partir de GPX, KML ou KMZ"""
    ext = file_path.suffix.lower()
    if ext == ".gpx":
        with file_path.open("r", encoding="utf-8") as f:
            gpx = gpxpy.parse(f)
        points = [
            (pt.longitude, pt.latitude)
            for track in gpx.tracks
            for seg in track.segments
            for pt in seg.points
        ]
        if len(points) < 3:
            raise ValueError("Pas assez de points pour créer un polygone")
        return Polygon(points)

    elif ext in [".kml", ".kmz"]:
        if ext == ".kmz":
            with zipfile.ZipFile(file_path, "r") as z:
                kml_bytes = None
                for name in z.namelist():
                    if name.endswith(".kml"):
                        kml_bytes = z.read(name)
                        break
                if kml_bytes is None:
                    raise ValueError("Aucun KML trouvé dans le KMZ.")
        else:
            kml_bytes = file_path.read_bytes()

        root = etree.fromstring(kml_bytes)
        ns = {"kml": "http://www.opengis.net/kml/2.2"}
        polygons = []
        for placemark in root.xpath(".//kml:Placemark", namespaces=ns):
            for poly_elem in placemark.xpath(".//kml:Polygon", namespaces=ns):
                coords_text = poly_elem.xpath(".//kml:coordinates/text()", namespaces=ns)
                for c in coords_text:
                    coords = [
                        (float(lon), float(lat))
                        for lon, lat, *_ in (p.split(",") for p in c.strip().split())
                    ]
                    if len(coords) >= 3:
                        polygons.append(Polygon(coords))
        if not polygons:
            raise ValueError(f"Aucun polygone trouvé dans {file_path}")
        return unary_union(polygons) if len(polygons) > 1 else polygons[0]
    else:
        raise ValueError("Format non supporté : GPX, KML ou KMZ uniquement")

def charger_couche(path: Path):
    """Charge un fichier SHP, GPX, KML ou KMZ en GeoDataFrame"""
    ext = path.suffix.lower()
    coords = []

    if ext == ".shp":
        return gpd.read_file(path)

    elif ext == ".gpx":
        with path.open("r", encoding="utf-8") as f:
            gpx = gpxpy.parse(f)
        for trk in gpx.tracks:
            for seg in trk.segments:
                for pt in seg.points:
                    coords.append((pt.longitude, pt.latitude))

    elif ext in [".kml", ".kmz"]:
        if ext == ".kmz":
            with zipfile.ZipFile(path, "r") as z:
                kml_name = next(n for n in z.namelist() if n.endswith(".kml"))
                tree = etree.parse(io.BytesIO(z.read(kml_name)))
        else:
            tree = etree.parse(path)
        for elem in tree.iter("{http://www.opengis.net/kml/2.2}coordinates"):
            for c in elem.text.strip().split():
                lon, lat, *_ = c.split(",")
                coords.append((float(lon), float(lat)))

    if not coords and ext != ".shp":
        return None
    if ext == ".shp":
        return gpd.read_file(path)
    return gpd.GeoDataFrame(geometry=[Point(xy) for xy in coords], crs="EPSG:4326")

def generer_journal(couches, output_path: Path):
    with output_path.open("w", encoding="utf-8") as f:
        f.write("=" * 60 + "\n")
        f.write("JOURNAL DE PROSPECTION\n")
        f.write("=" * 60 + "\n")
        f.write(f"Date: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n\n")
        for nom, gdf in couches.items():
            f.write(f"{nom.upper():<15}: {len(gdf) if gdf is not None else 0} entités\n")
        f.write("=" * 60 + "\n")
        f.write("Remarques:\n")
        f.write("• Surface prospectée = Contour\n")
        f.write("• Fractures = Lines\n")
        f.write("• Dolines = Points rouges\n")
        f.write("• Points de forage = Intersections\n")
    return True

def shp_to_kml_gpx_kmz(gdf, basename, target_dirs):
    """Convertit un GeoDataFrame en KML, KMZ et GPX"""
    if gdf is None or gdf.empty:
        return
    if gdf.crs is None:
        gdf = gdf.set_crs(epsg=4326)
    elif gdf.crs.to_epsg() != 4326:
        gdf = gdf.to_crs(epsg=4326)

    kml = simplekml.Kml()
    for i, geom in enumerate(gdf.geometry):
        name = f"{basename}_{i+1}"
        if geom.geom_type == "Point":
            kml.newpoint(name=name, coords=[(geom.x, geom.y)])
        elif geom.geom_type == "LineString":
            kml.newlinestring(name=name, coords=list(geom.coords))
        elif geom.geom_type == "Polygon":
            kml.newpolygon(name=name, outerboundaryis=list(geom.exterior.coords))

    kml_path = target_dirs["kml"] / f"{basename}.kml"
    kml.save(kml_path)

    kmz_path = target_dirs["kmz"] / f"{basename}.kmz"
    with zipfile.ZipFile(kmz_path, "w", zipfile.ZIP_DEFLATED) as z:
        z.write(kml_path, arcname=f"{basename}.kml")

    gpx = gpxpy.gpx.GPX()
    for geom in gdf.geometry:
        if geom.geom_type == "Point":
            gpx.waypoints.append(gpxpy.gpx.GPXWaypoint(latitude=geom.y, longitude=geom.x))
    gpx_path = target_dirs["gpx"] / f"{basename}.gpx"
    gpx_path.write_text(gpx.to_xml(), encoding="utf-8")

# ================== MAIN ==================
def main():
    dossier_client, nom_client = choisir_dossier_client()

    # RENDU – Autres couches
    dossier_RENDU = dossier_client / "RENDU"
    
    # ================== CHERCHER LE CONTOUR (AVEC FALLBACK) ==================
    contour_input_path = None
    
    # 1. Chercher dans INPUT (GPX, KML, KMZ)
    input_dir = dossier_client / "INPUT"
    if input_dir.exists():
        contour_files = [f for f in input_dir.iterdir() if f.suffix.lower() in [".gpx", ".kml", ".kmz"]]
        if contour_files:
            contour_input_path = contour_files[0]
            st.info(f"📁 Contour trouvé dans INPUT: {contour_input_path.name}")
    
    # 2. Fallback: Utiliser CONTOUR.shp du dossier RENDU
    if contour_input_path is None:
        contour_shp = dossier_RENDU / "CONTOUR.shp"
        if contour_shp.exists():
            contour_input_path = contour_shp
            st.info(f"📁 Fallback: utilisation de CONTOUR.shp comme contour")
    
    # 3. Erreur si rien trouvé
    if contour_input_path is None:
        st.error(f"❌ Aucun fichier de contour trouvé (cherché dans INPUT/*.gpx/.kml/.kmz ou RENDU/CONTOUR.shp)")
        st.stop()
    
    # Charger le contour
    if contour_input_path.suffix.lower() == ".shp":
        contour_gdf = gpd.read_file(contour_input_path).to_crs(epsg=3857)
    else:
        contour_poly = load_contour(contour_input_path)
        contour_gdf = gpd.GeoDataFrame(geometry=[contour_poly], crs="EPSG:4326").to_crs(epsg=3857)

    couches = {
        "contour": contour_gdf,
        "lines": None,
        "dolines": None,
        "intersections": None,
    }

    for f in dossier_RENDU.iterdir():
        lf = f.name.lower()
        if lf.endswith((".shp", ".gpx", ".kml", ".kmz")):
            gdf = charger_couche(f)
            if gdf is None or gdf.empty:
                continue
            gdf = gdf.to_crs(epsg=3857)
            if "lignes" in lf or "lines" in lf:
                couches["lines"] = gdf
            elif "dolines" in lf:
                couches["dolines"] = gdf
            elif "intersections" in lf:
                couches["intersections"] = gdf

    # ================== AFFICHAGE ==================
    fig, ax = plt.subplots(figsize=(14, 12))
    handles = []

    if couches.get("lines") is not None:
        couches["lines"].plot(ax=ax, color="orange", linewidth=3.0, linestyle="--", alpha=0.8, zorder=6)
    handles.append(mpatches.Patch(facecolor="orange", edgecolor="orange", label="Fractures identifiées"))

    if couches.get("dolines") is not None:
        couches["dolines"].plot(ax=ax, color="red", markersize=60, alpha=0.5, marker="o", edgecolor="white", linewidth=1.0, zorder=4)
    handles.append(mpatches.Patch(facecolor="red", edgecolor="white", label="Dolines"))

    if couches.get("intersections") is not None:
        couches["intersections"].plot(ax=ax, color="lime", markersize=100, marker="*", edgecolor="black", linewidth=1.5, alpha=0.9, zorder=5)
    handles.append(mpatches.Patch(facecolor="lime", edgecolor="black", label="Points de forage"))

    couches["contour"].plot(ax=ax, facecolor="none", edgecolor="darkblue", linewidth=3, alpha=0.9, zorder=5)
    handles.append(mpatches.Patch(facecolor="none", edgecolor="darkblue", linewidth=3, label="Surface prospectée"))

    # ================== FOND DE CARTE ==================
    satellite_sources = [
        "http://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}",
        "https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}",
        ctx.providers.Esri.WorldImagery,
        "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
        ctx.providers.Bing.Aerial,
    ]

    satellite_loaded = False
    for i, source in enumerate(satellite_sources):
        try:
            ctx.add_basemap(ax, source=source, crs="EPSG:3857", zorder=0, timeout=30)
            st.success(f"✅ Fond de carte satellite chargé (source {i+1})")
            satellite_loaded = True
            break
        except:
            continue

    if not satellite_loaded:
        try:
            ctx.add_basemap(ax, source=ctx.providers.OpenStreetMap.Mapnik, crs="EPSG:3857", zorder=0, timeout=30)
            st.success("✅ Fond de carte OpenStreetMap chargé (fallback)")
        except:
            ax.set_facecolor("#e8f4f8")
            ax.grid(True, alpha=0.3, linestyle="--", linewidth=0.5)

    ax.set_axis_off()
    ax.set_title(f"🗺️ Carte de prospection – Projet {nom_client}", fontsize=18, weight="bold")
    ax.legend(handles=handles, loc="lower left", fontsize=10, frameon=True, framealpha=0.95)
    plt.tight_layout()

    # ================== EXPORT ==================
    rapport_dir = dossier_RENDU / f"Rapport_{nom_client}"
    rapport_dir.mkdir(parents=True, exist_ok=True)

    fig_path = rapport_dir / "carte_prospection.png"
    fig.savefig(fig_path, dpi=150, bbox_inches="tight", pad_inches=0.1, facecolor="white", edgecolor="none")
    st.pyplot(fig, clear_figure=True)
    plt.close(fig)

    data_dir = rapport_dir / "Data"
    convertir_dir = rapport_dir / "Convertir"
    shp_dir = data_dir / "SHP"
    gpx_dir = data_dir / "GPX"
    kml_dir = data_dir / "KML"
    kmz_dir = data_dir / "KMZ"
    for d in [data_dir, convertir_dir, shp_dir, gpx_dir, kml_dir, kmz_dir]:
        d.mkdir(parents=True, exist_ok=True)

    for f in dossier_RENDU.iterdir():
        if f.suffix.lower() == ".shp":
            base = f.stem
            for ext in [".shp", ".shx", ".dbf", ".prj", ".cpg"]:
                src = dossier_RENDU / f"{base}{ext}"
                if src.exists():
                    shutil.copy(src, shp_dir / src.name)

    generer_journal(couches, rapport_dir / "journal.txt")

    convertir_src = dossier_client / "OUTPUT" / "Convertir"
    if convertir_src.exists():
        shutil.copytree(convertir_src, convertir_dir, dirs_exist_ok=True)

    target_dirs = {"kml": kml_dir, "kmz": kmz_dir, "gpx": gpx_dir}
    for nom, gdf in couches.items():
        if gdf is not None:
            shp_to_kml_gpx_kmz(gdf, f"{nom_client}_{nom}", target_dirs)

    zip_path = rapport_dir.parent / f"{nom_client}.zip"
    shutil.make_archive(base_name=str(zip_path.with_suffix("")), format="zip", root_dir=rapport_dir)
    st.info(f"📦 Archive ZIP générée : {zip_path.name}")

# ================== LANCEMENT ==================
if __name__ == "__main__":
    main()